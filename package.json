{
  "name": "digital-game-store",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "db:setup": "tsx scripts/setup-db.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:routines": "tsx scripts/update-routines.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write src scripts tests docs .github README.md package.json tsconfig.json playwright.config.ts",
    "format:check": "prettier --check src scripts tests docs .github README.md package.json tsconfig.json playwright.config.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.9",
    "jose": "^6.2.15",
    "mysql2": "^3.24.6",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
